{
  "name": "mobile-copilot-monorepo",
  "private": true,
  "description": "Mobile Copilot — monorepo for cross-IDE mobile remote control",
  "version": "0.2.0",
  "license": "MIT",
  "workspaces": [
    "packages/protocol",
    "packages/adapter-core",
    "packages/adapter-vscode",
    "packages/mobile-app"
  ],
  "scripts": {
    "build": "node packages/adapter-vscode/esbuild.js",
    "build:all": "node packages/adapter-vscode/esbuild.js",
    "start:mobile": "cd packages/mobile-app && CI=1 EXPO_NO_TYPESCRIPT_SETUP=1 npx expo start",
    "watch": "node packages/adapter-vscode/esbuild.js --watch",
    "typecheck": "tsc --build packages/protocol packages/adapter-core",
    "clean": "rm -rf packages/*/dist",
    "package": "cd packages/adapter-vscode && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "install-ext": "code --install-extension packages/adapter-vscode/mobile-copilot-0.2.0.vsix --force"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "express": "^4.18.2",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.3",
    "react-native-worklets": "0.5.1",
    "ws": "^8.16.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "@types/react": "~19.1.10"
  }
}
